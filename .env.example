# Database: PostgreSQL or SQLite (see CLAUDE.md)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sw_inventory?schema=public"
# DATABASE_URL="file:./dev.db"

# Single demo user. The whole app (pages and /api) requires login.
AUTH_USERNAME=demo
AUTH_PASSWORD=change-me-please
# Signs session cookies. Generate with: openssl rand -hex 32   (changing it logs everyone out)
AUTH_SECRET=replace-with-64-hex-chars-from-openssl-rand-hex-32-xxxxxxxxxxxxxxx
# AUTH_SESSION_HOURS=12

# Production (adapter-node, `node build`):
# ORIGIN=https://demo.example.com   # public URL; required for form posts to pass the CSRF check
# PORT=3000
# If behind a reverse proxy that terminates TLS, instead of ORIGIN you can set:
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host

# Deploying from this PC (npm run deploy, see DEPLOY.md part 2). Not needed on the server.
# DEPLOY_HOST=ubuntu@demo.example.com      # ssh user (needs sudo) @ server
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519         # optional, otherwise ssh's default key / config
# DEPLOY_APP_DIR=/opt/sw-inventory/app     # defaults shown
# DEPLOY_BACKUP_DIR=/opt/sw-inventory/backups
# DEPLOY_SERVICE=sw-inventory
